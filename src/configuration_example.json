{
    "environment": "Prod",
    "server_port": 3000,
    "log_level": "info",
    "app_domain": "my-app.com",
    "database_connection_string": "postgres://portfolio_user:portfolio_password@server_ip:8303/portfolio",
    "database_pool": {
        "max_connections": 20,
        "min_connections": 4,
        "acquire_timeout_secs": 5
    },
    "run_database_migrations": false,
    "secrets": {
        "coingecko_api_key": "***"
    },
    "jobs": {
        "update_exchange_rate_cron": "0 */10 * * * *"
    }
}
