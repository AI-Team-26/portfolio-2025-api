{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "📥 GIT Fetch",
            "type": "shell",
            "command": "git fetch --prune origin",
            "group": "none"
        },
        {
            "label": "➕ GIT push TODO task",
            "type": "shell",
            "command": "git add TODO.md && git commit -m 'todo: add task' && git push --force",
            "group": "none"
        },
        {
            "label": "🦀 Cargo Build",
            "type": "shell",
            "options": { 
                "cwd": "${workspaceFolder}",
                "env": { "SQLX_OFFLINE": "true" },
            },
            "command": "cargo build",
            "group": "build"
        },
        {
            "label": "☑️ Cargo Lint",
            "type": "shell",
            "options": { 
                "cwd": "${workspaceFolder}",
            },
            "command": "cargo fmt && cargo clippy --all-targets --all-features -- -D warnings",
            "group": "build"
        },
        {
            "label": "🧪 Cargo Test",
            "type": "shell",
            "options": { 
                "cwd": "${workspaceFolder}",
                "env": { "SQLX_OFFLINE": "true" },
            },
            "command": "cargo test",
            "group": "build"
        },
        {
            "label": "🧠 Cargo SQLx Prepare",
            "type": "shell",
            "options": { "cwd": "${workspaceFolder}"},
            "command": "cargo sqlx prepare",
            "group": "build"
        },
        {
            "label": "🐳 Docker Compose Up",
            "type": "shell",
            "options": { "cwd": "${workspaceFolder}/devop"},
            "command": "docker compose -f compose.all.yaml up --build -d",
            "group": "build"
        }
    ]
}