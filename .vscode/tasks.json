{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "🦀 Cargo Build",
            "note": "sqlX requires the database up and running (Docker container)",
            "type": "shell",
            "options": { "cwd": "${workspaceFolder}" },
            "command": "cargo build",
            "group": "build"
        },
        {
            "label": "🧠 Cargo SQLx Prepare",
            "type": "shell",
            "options": { "cwd": "${workspaceFolder}"},
            "command": "cargo sqlx prepare",
            "group": "build"
        },
        {
            "label": "🐳 Docker Compose Up",
            "type": "shell",
            "options": { "cwd": "${workspaceFolder}/devop"},
            "command": "docker compose -f compose.all.yaml up --build -d",
            "group": "build"
        }
    ]
}